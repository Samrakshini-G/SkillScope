/* ==========================================================================
   SkillScope — Modern Academic Desktop Application Stylesheet
   Design Language: Clean, Modern Light Palette
   Palette:
     Main Background:   #F5F6FC
     Card Background:   #FFFFFF
     Sidebar:           #FFFFFF
     Primary Blue:      #4169E1
     Secondary Purple:  #8064E8
     Teal:              #25B99A
     Success Green:     #20B486
     Warning Orange:    #F3A640
     Error Red:         #E56B75
     Main Text:         #202B45
     Secondary Text:    #7A849B
     Border:            #E8EAF2
   ========================================================================== */

/* Global Widget Baseline */
QWidget {
    font-family: "Segoe UI", "Segoe UI Emoji", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 13px;
    color: #202B45;
    background-color: #F5F6FC;
}

/* Ensure ALL labels are clean text by default with NO borders or background */
QLabel {
    border: none;
    background-color: transparent;
    padding: 0px;
    margin: 0px;
}

/* Tooltips */
QToolTip {
    background-color: #202B45;
    color: #FFFFFF;
    border: 1px solid #354366;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* ==========================================================================
   Sidebar Navigation
   ========================================================================== */
#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E8EAF2;
    min-width: 250px;
    max-width: 250px;
}

#appLogoTitle {
    color: #202B45;
    font-size: 20px;
    font-weight: 800;
    padding: 10px 0 2px 0;
}

#appLogoSubtitle {
    color: #7A849B;
    font-size: 11px;
    font-weight: 600;
    padding-bottom: 12px;
}

QPushButton.nav-btn {
    text-align: left;
    padding: 11px 16px;
    border: none;
    border-radius: 10px;
    background-color: transparent;
    color: #7A849B;
    font-size: 13px;
    font-weight: 600;
    margin: 2px 10px;
}

QPushButton.nav-btn:hover {
    background-color: #F5F6FC;
    color: #4169E1;
}

QPushButton.nav-btn:checked, QPushButton.nav-btn.active {
    background-color: #EEF2FF;
    color: #4169E1;
    font-weight: 700;
    border-left: 3px solid #4169E1;
}

/* ==========================================================================
   Top Header Bar
   ========================================================================== */
#headerBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8EAF2;
    padding: 12px 28px;
}

#headerTitle {
    font-size: 19px;
    font-weight: 800;
    color: #202B45;
}

#headerSubtitle {
    font-size: 12px;
    color: #7A849B;
    font-weight: 500;
}

#userBadge {
    background-color: #EEF2FF;
    color: #4169E1;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 16px;
    border: 1px solid #D7E1FD;
    font-size: 12px;
}

/* ==========================================================================
   Cards & Frames
   ========================================================================== */
.card, .metric-card {
    background-color: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #E8EAF2;
}

QLabel.metric-value {
    font-size: 26px;
    font-weight: 800;
    color: #202B45;
}

QLabel.metric-label {
    font-size: 11px;
    font-weight: 700;
    color: #7A849B;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ==========================================================================
   Buttons
   ========================================================================== */
QPushButton {
    font-weight: 600;
    border-radius: 8px;
    padding: 8px 16px;
    outline: none;
}

QPushButton.btn-primary {
    background-color: #4169E1;
    color: #FFFFFF;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 9px;
    border: none;
}

QPushButton.btn-primary:hover {
    background-color: #3557C7;
}

QPushButton.btn-primary:pressed {
    background-color: #2A46A8;
}

QPushButton.btn-primary:disabled {
    background-color: #E8EAF2;
    color: #A0A8BF;
}

QPushButton.btn-secondary {
    background-color: #FFFFFF;
    color: #202B45;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 9px;
    border: 1px solid #E8EAF2;
}

QPushButton.btn-secondary:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #4169E1;
}

QPushButton.btn-secondary:pressed {
    background-color: #EDF2F7;
}

QPushButton.btn-success {
    background-color: #20B486;
    color: #FFFFFF;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 9px;
    border: none;
}

QPushButton.btn-success:hover {
    background-color: #1AA076;
}

QPushButton.btn-danger {
    background-color: #FDF0F1;
    color: #E56B75;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #F8C8CC;
}

QPushButton.btn-danger:hover {
    background-color: #E56B75;
    color: #FFFFFF;
    border-color: #E56B75;
}

/* ==========================================================================
   Inputs, Dropdowns & Form Controls
   ========================================================================== */
QLineEdit, QComboBox, QSpinBox, QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #E8EAF2;
    border-radius: 8px;
    padding: 8px 12px;
    color: #202B45;
    selection-background-color: #4169E1;
    selection-color: #FFFFFF;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1.5px solid #4169E1;
    background-color: #FFFFFF;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #F8FAFC;
    color: #A0A8BF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #E8EAF2;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: #FFFFFF;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7A849B;
    width: 0;
    height: 0;
    margin-right: 2px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E8EAF2;
    border-radius: 8px;
    selection-background-color: #EEF2FF;
    selection-color: #4169E1;
    padding: 4px;
    outline: none;
}

/* ==========================================================================
   Tab Widget
   ========================================================================== */
QTabWidget::pane {
    border: 1px solid #E8EAF2;
    border-radius: 12px;
    background-color: #FFFFFF;
    padding: 16px;
}

QTabBar::tab {
    font-size: 13px;
    font-weight: 700;
    padding: 9px 22px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    background-color: #F5F6FC;
    color: #7A849B;
    margin-right: 4px;
    border: 1px solid transparent;
}

QTabBar::tab:hover {
    color: #4169E1;
    background-color: #EEF2FF;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #4169E1;
    border: 1px solid #E8EAF2;
    border-bottom: 2px solid #FFFFFF;
}

/* ==========================================================================
   Tables
   ========================================================================== */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E8EAF2;
    border-radius: 10px;
    gridline-color: #F5F6FC;
    selection-background-color: #EEF2FF;
    selection-color: #202B45;
    outline: none;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F5F6FC;
}

QTableWidget::item:selected {
    background-color: #EEF2FF;
    color: #202B45;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    font-weight: 700;
    font-size: 12px;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #E8EAF2;
    text-align: left;
}

/* ==========================================================================
   Progress Bars
   ========================================================================== */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #E8EAF2;
    height: 12px;
    text-align: center;
    color: #202B45;
    font-weight: 700;
    font-size: 10px;
}

QProgressBar::chunk {
    background-color: #4169E1;
    border-radius: 6px;
}

/* ==========================================================================
   Scrollbars & ScrollArea
   ========================================================================== */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
